# Application
PORT=3001
NODE_ENV=development

# Webhook Security
WEBHOOK_SECRET=whsec_09a1f28b7e654321cba9876543210fed
HMAC_TOLERANCE_SECONDS=300

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_DATABASE=notifications_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis (BullMQ & Socket.IO Redis Adapter)
REDIS_HOST=localhost
REDIS_PORT=6379

# BullMQ Config
BULLMQ_CONCURRENCY=15
BULLMQ_RETRY_ATTEMPTS=5
BULLMQ_BACKOFF_DELAY_MS=2000

# Idempotency Cache TTL (Seconds)
IDEMPOTENCY_TTL_SECONDS=86400
